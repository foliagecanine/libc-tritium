#ifndef __VECTOR__
#define __VECTOR__

#include <cstddef>
#include <cstdint>

extern "C++" {

namespace std {

    template <typename T>
    class vector {
    public:
        vector();
        ~vector();
        void push_back(const T& value);
        void pop_back();
        T& operator[](size_t index);
        size_t size() const;
    private:
        T *m_data;
        size_t m_size;
        size_t m_capacity;
    };

} // namespace std

} // extern "C++"

#endif